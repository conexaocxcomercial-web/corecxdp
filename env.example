# Planilha do Google Sheets usada como base de dados.
# Copie o trecho entre /d/ e /edit da URL da planilha.
GOOGLE_SHEET_ID=

# Conta de serviço do Google Cloud com a API do Google Sheets ativada.
# A planilha precisa estar compartilhada com este e-mail como Editor.
GOOGLE_CLIENT_EMAIL=core-cx-dp@seu-projeto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"

# De qual empresa são os dados desta instalação.
# Vazio: mostra a planilha inteira, e a coluna Cliente nem precisa existir.
# Preenchido: mostra só as linhas com esse código na coluna Cliente.
CLIENTE_PADRAO=
EMPRESA_PADRAO=
